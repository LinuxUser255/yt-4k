#!/usr/bin/env bash
# =============================================================================
# SCRIPT:       yt4k
# DESCRIPTION:  Download 4K videos, best-quality videos or audio using yt-dlp,
#               including age-restricted videos (via browser cookies).
# USAGE:        ./yt4k [OPTIONS] <URL> [OUTPUT_DIR]
# DEPENDENCIES: yt-dlp (required), ffmpeg (needed to merge/convert streams)
# LICENSE:      GNU GPL v3.0 (see LICENSE)
# -----------------------------------------------------------------------------
# INSTALL
#   curl -LO https://gitlab.com/LinuxUser255/
#   chmod +x yt4k
#   sudo mv yt4k /usr/local/bin/       # makes it globally executable
#
# QUICK START
#   ./yt4k --help
#
# RECOMMENDED ALIASES  (~/.bashrc or ~/.zshrc)
#   alias yt='yt4k '                        # enforce 4K video downloads
#   alias yta='yt4k -a --audio-format wav ' # enforce wav audio downloads
#   alias ytb='yt4k -b -i '                 # best quality, video ID in filename
#
# COOKIES / AGE-RESTRICTED VIDEOS
#   YouTube's bot check ("Sign in to confirm you're not a bot") and its age
#   gate both need cookies from a logged-in browser. For YouTube URLs this
#   script passes Brave's cookies automatically, so age-restricted videos
#   download as long as that browser profile is signed in to an age-verified
#   account. Pick a specific profile with --profile / YT4K_BROWSER_PROFILE.
#   Reading the browser profile on macOS requires the terminal to have Full
#   Disk Access; without it yt-dlp reports the misleading "could not find
#   brave cookies database". On Linux the profile is found under ~/.config
#   (or XDG_CONFIG_HOME), and Flatpak and Snap installs are detected too.
# =============================================================================
set -euo pipefail                                      # §1 strict-mode
IFS=$'\n\t'                                            # §1 strict-mode

# =============================================================================
# CONFIGURATION — Set defaults here.
# =============================================================================

# OUTPUT_DIR defaults to your current working directory
OUTPUT_DIR="${YT4K_OUTPUT_DIR:-${PWD}}"                # §5 no-fork: ${PWD} replaces $(pwd)
MAX_HEIGHT="${YT4K_MAX_HEIGHT:-2160}"
# Default audio format is wav because it's the highest quality audio format
AUDIO_FORMAT="${YT4K_AUDIO_FORMAT:-wav}"
DEBUG="${DEBUG:-0}"                                    # §2 required for debug()

# Output filename templates (yt-dlp syntax). --id switches to the second one.
OUTPUT_TEMPLATE="${YT4K_OUTPUT_TEMPLATE:-%(title)s.%(ext)s}"
OUTPUT_TEMPLATE_ID='%(title)s [%(id)s].%(ext)s'

# Retries per download. Empty keeps yt-dlp's own default (10).
RETRIES="${YT4K_RETRIES:-}"

# Cookie settings. Cookies are sent only to YouTube URLs by default so that an
# unrelated site never receives your browser's cookie jar.
BROWSER="${YT4K_BROWSER:-brave}"
BROWSER_PROFILE="${YT4K_BROWSER_PROFILE:-}"            # empty = yt-dlp picks the profile
COOKIES_FILE="${YT4K_COOKIES:-}"
USE_COOKIES="${YT4K_COOKIES_MODE:-auto}"               # auto | always | never

COOKIE_ARGS=()                                         # §8 populated by setup_cookies
COOKIE_SOURCE="none"                                   # none | file | browser
DOWNLOAD_ARGS=()                                       # §8 populated by setup_download_args

# =============================================================================
# COLORS
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'                                           # §13 removed BLUE: unused (SC2034)
[[ -t 1 ]] || { RED=''; GREEN=''; YELLOW=''; NC=''; }  # §11 suppress when not a terminal
readonly RED GREEN YELLOW NC                           # §8 constants
readonly OUTPUT_DIR MAX_HEIGHT AUDIO_FORMAT            # §8 constants
readonly OUTPUT_TEMPLATE OUTPUT_TEMPLATE_ID            # §8 constants

# =============================================================================
# BANNER
# =============================================================================

