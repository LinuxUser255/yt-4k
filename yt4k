        printf '%b\n' "  \033[1;37m██   ██    ██     \033[1;31m██   ██  ██       ██   ██ \033[0m"  # §7 §11
        printf '%b\n' "  \033[1;37m███ ███    ██     \033[1;31m██   ██  ██       ██   ██ \033[0m"  # §7 §11
        printf '%b\n' "  \033[1;37m █████     ██     \033[1;31m██   ██  ██       ██████  \033[0m"  # §7 §11
        printf '%b\n' "  \033[1;37m  ███      ██     \033[1;31m██   ██  ██       ██      \033[0m"  # §7 §11
