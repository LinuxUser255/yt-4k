# Subtitles, thumbnails and metadata written by yt-dlp
*.vtt
*.srt
*.ass
*.lrc
*.webp
*.info.json
*.description
*.annotations.xml
*.live_chat.json

# yt-dlp / ffmpeg partial and temporary files
*.part
*.part-Frag*
*.ytdl
*.temp
*.temp.*
*.f[0-9]*.*
.yt-dlp/
yt-dlp-archive.txt

# Images are ignored as download by-products, except the project's own
*.jpg
*.jpeg
*.png
*.gif
!images/
!images/**

